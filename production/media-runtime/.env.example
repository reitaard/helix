HELIX_PORT=8787
HELIX_WORKER_RTX4060_URL=http://COMFY_TAILSCALE_ADDRESS:8188
HELIX_WORKER_RTX4060_NAME=Helix RTX 4060
HELIX_WORKER_RTX4060_REVISION=COMFY_VALIDATED_COMMIT_SHA
HELIX_DATABASE_URL=postgresql://helix:CHANGE_ME@helix-db:5432/helix

# Primary generation bot. Configure token/chat together.
HELIX_TELEGRAM_BOT_TOKEN=PRIMARY_BOT_TOKEN
HELIX_TELEGRAM_CHAT_ID=PRIVATE_OPERATOR_CHAT_ID
# Optional primary-bot forum routing: configure all three together.
HELIX_TELEGRAM_FORUM_CHAT_ID=-1000000000000
HELIX_TELEGRAM_T2I_THREAD_ID=5
HELIX_TELEGRAM_T2V_THREAD_ID=7

# Optional FaceFusion backend and dedicated private-chat bot.
# Local integration only; do not deploy while worker auth is disabled.
HELIX_FACEFUSION_WORKER_URL=http://FACEFUSION_PC_TAILSCALE_ADDRESS:PORT
HELIX_FACEFUSION_WORKER_REVISION=FACEFUSION_WORKER_REVISION
# Configure only after a real worker token is provisioned:
# HELIX_FACEFUSION_WORKER_TOKEN=FACEFUSION_WORKER_BEARER_TOKEN
HELIX_FACEFUSION_TELEGRAM_BOT_TOKEN=FACEFUSION_BOT_TOKEN
HELIX_FACEFUSION_TELEGRAM_CHAT_ID=PRIVATE_OPERATOR_CHAT_ID
HELIX_FACEFUSION_TELEGRAM_FORUM_CHAT_ID=FACEFUSION_FORUM_CHAT_ID
HELIX_FACEFUSION_TELEGRAM_THREAD_ID=FACEFUSION_TOPIC_THREAD_ID
HELIX_FACEFUSION_INPUT_MAX_MB=512

HELIX_SPOOL_DIR=/tmp/helix-spool
HELIX_JOB_TIMEOUT_SECONDS=3600
